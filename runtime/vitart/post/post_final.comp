#version 450
// Resolução cheia: oclusão, bloom, exposição, curva fílmica (ACES ajustada, normalizada para não
// escurecer os meios-tons do jogo), saturação e vinheta; grava no próprio alvo de cor.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "post_common.glsl"

vec3 aces(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    ivec2 f = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = ivec2(pc.p2.yz);
    if (f.x >= sz.x || f.y >= sz.y) return;
    vec2 uv = (vec2(f) + 0.5) / vec2(sz);
    vec4 src = texelFetch(uColor, f, 0);
    vec3 c = srgb_to_lin(src.rgb);
    vec4 a = textureLod(uAs, uv, 0.0);
    c *= mix(1.0, a.a, pc.p0.z);
    c += a.rgb * pc.p1.x;
    c *= pc.p1.y;
    // curva fílmica normalizada: 0,18 (cinza médio) continua 0,18; altas luzes comprimem suave
    vec3 t = aces(c * 0.8) * (0.18 / aces(vec3(0.18 * 0.8)).r);
    c = mix(c, min(t, vec3(1.0)), pc.p1.z);
    float l = lum(c);
    c = max(mix(vec3(l), c, pc.p1.w), 0.0);
    vec2 r = uv - 0.5;
    c *= 1.0 - pc.p2.x * dot(r, r) * 2.0;
    imageStore(uOut, f, vec4(lin_to_srgb(c), src.a));
}
